# Скопируй этот файл в .env и заполни нужные переменные
# Переменные окружения переопределяют значения из config.yaml

# Ключ судьи Gemini (бесплатно: aistudio.google.com/apikey)
GEMINI_API_KEY=

# Ключ для OpenAI-compatible судьи (если judge.type = openai_compatible)
JUDGE_API_KEY=

# Переопределить модель и URL цели
# TARGET_MODEL=qwen2.5:7b
# OLLAMA_URL=http://localhost:11434
